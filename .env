# Flask Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production
FLASK_DEBUG=True
FLASK_ENV=development

# Database Configuration
# For MySQL (Development with XAMPP)
DATABASE_URL=mysql+mysqlclient://root:@localhost/heart_disease_db

# For SQLite (Alternative Development)
# DATABASE_URL=sqlite:///heart_disease_app.db

# For Azure SQL Database (Production)
# DATABASE_URL=mssql+pyodbc://username:password@server.database.windows.net:1433/database?driver=ODBC+Driver+17+for+SQL+Server

# Model Configuration
MODEL_PATH=heart_disease_rf_model.pkl

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True

# Logging
LOG_LEVEL=INFO

# Azure App Service Configuration (if deploying to Azure)
# WEBSITES_PORT=5000
# SCM_DO_BUILD_DURING_DEPLOYMENT=true 