# Flask Configuration
SECRET_KEY=helloMySystem@1207
FLASK_DEBUG=True
FLASK_ENV=development

# Azure SQL Database Configuration
AZURE_DB_SERVER=greenscanserver.database.windows.net
AZURE_DB_NAME=heart_disease_db
AZURE_DB_USERNAME=Malay
AZURE_DB_PASSWORD=Greenscan@12

# Database Configuration
# For Azure SQL Database (Current Setup)
DATABASE_URL=mssql+pyodbc://Malay:Greenscan%4012@greenscanserver.database.windows.net:1433/heart_disease_db?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=no&Connection+Timeout=30
# DATABASE_URL=mysql://root:@localhost/heart_disease_db

# For SQLite (Alternative Development)
# DATABASE_URL=sqlite:///heart_disease_app.db

# Model Configuration
MODEL_PATH=heart_disease_rf_model.pkl

# Security Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=uploads

# Logging
LOG_LEVEL=INFO

# Azure App Service Configuration (if deploying to Azure)
WEBSITES_PORT=5000
